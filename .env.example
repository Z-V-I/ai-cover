# ============================================================
#  AI 翻唱 —— 本地敏感配置模板
# ------------------------------------------------------------
#  用法：
#      cp .env.example .env
#      编辑 .env 填入真实值
#
#  .env 已在 .gitignore 中，不会提交到仓库；请勿把真实值写进
#  任何会被提交的文件（源码、文档、nginx.conf 等）。
#
#  生成随机串：python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# ============================================================

# ---------- 决策层 ----------
# 前端每个 /api/* 请求都要带 X-API-Token 头，值必须和这里一致。
# 未设置时决策层会拒绝启动（空 token 会让鉴权形同虚设）。
API_TOKEN=CHANGE_ME

# 决策层转发推理请求的目标地址
#   本机直连推理层：http://localhost:8081
#   生产（推理机在 WSL2/内网，经 frp 打通到云端）：http://localhost:18081
INFERENCE_BASE_URL=http://localhost:18081

# 决策层监听端口
DECISION_PORT=5000

# 上传/结果目录（默认在 decision/ 下）
# UPLOAD_DIR=/opt/svc-decision/uploads
# RESULT_DIR=/opt/svc-decision/results


# ---------- 推理层（inference/install-wsl.sh）----------
# 云端服务器公网 IP（frps 所在机器）。跑 frp 阶段必需。
ECS_IP=CHANGE_ME

# frps / frpc 的 auth.token，两端必须一致。跑 frp 阶段必需。
FRP_TOKEN=CHANGE_ME
